{
  "name": "@studiochain/contracts",
  "version": "1.0.0",
  "author": "StudioChain Team",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.6",
    "@nomicfoundation/hardhat-verify": "^3.0.18",
    "@openzeppelin/contracts": "^5.6.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "hardhat": "^3.6.0",
    "solhint": "^6.2.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^6.0.3"
  },
  "description": "StudioChain tokenomics smart contracts",
  "directories": {
    "test": "test"
  },
  "keywords": [
    "studiochain",
    "tokenomics",
    "nft",
    "defi",
    "smart-contracts",
    "ethereum",
    "polygon"
  ],
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "hardhat node",
    "build": "hardhat compile",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "deploy:polygon": "hardhat run scripts/deploy.ts --network polygon",
    "verify:amoy": "hardhat verify --network amoy",
    "verify:polygon": "hardhat verify --network polygon",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "typechain": "hardhat typechain",
    "lint": "solhint 'contracts/**/*.sol'",
    "lint:fix": "solhint 'contracts/**/*.sol' --fix",
    "type-check": "tsc --noEmit"
  },
  "type": "module"
}
