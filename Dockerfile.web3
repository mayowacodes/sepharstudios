# Sephar Studios - Dockerfile with Web3 Support
# Optimized multi-stage build for monorepo architecture

# ==========================================
# Stage 1: Build
# ==========================================
FROM oven/bun:1.3.9 AS builder

WORKDIR /app

# Copy workspace package files (for dependency caching)
COPY bun.lock package.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/web3/package.json ./packages/web3/
COPY packages/shared/package.json ./packages/shared/
COPY packages/contracts/package.json ./packages/contracts/

# Install all dependencies
# --linker=hoisted: Bun 1.3 defaults workspaces to isolated installs
# (symlinks into node_modules/.bun), which dangle after the stage-2
# node_modules copy and crash the server with ERR_MODULE_NOT_FOUND.
# Hoisted mode produces real directories that survive the copy.
RUN bun install --frozen-lockfile --linker=hoisted

# Copy all source code
COPY apps ./apps
COPY packages ./packages
COPY drizzle.config.ts ./
COPY tsconfig.json ./

# Build web3 package first (needed by web app)
WORKDIR /app/packages/web3
RUN bun run build || echo "Web3 build skipped (no build script)"

# Build shared package
WORKDIR /app/packages/shared
RUN bun run build || echo "Shared build skipped (no build script)"

# Build the main web application
WORKDIR /app/apps/web

# Create minimal .env for build (actual env vars provided at runtime)
RUN echo "DATABASE_URL=postgresql://dummy:dummy@localhost:5432/dummy" > .env && \
    echo "BETTER_AUTH_SECRET=dummy-secret-key-for-build-only-minimum-32chars" >> .env && \
    echo "BETTER_AUTH_URL=http://localhost:3000" >> .env && \
    echo "NODE_ENV=production" >> .env && \
    echo "MINIO_ENDPOINT=localhost" >> .env && \
    echo "MINIO_PORT=9000" >> .env && \
    echo "MINIO_ACCESS_KEY=dummy" >> .env && \
    echo "MINIO_SECRET_KEY=dummy" >> .env && \
    echo "MINIO_USE_SSL=false" >> .env && \
    echo "MINIO_BUCKET=dummy" >> .env

# Build the application
RUN bun run build

# Verify build output
RUN ls -la build/ && echo "Build completed successfully!"

# Hoisted installs may not create apps/web/node_modules at all (no
# version conflicts → everything hoists to root). Docker COPY fails on
# a missing source dir, so guarantee it exists (empty = no-op merge).
RUN mkdir -p /app/apps/web/node_modules

# ==========================================
# Stage 2: Production
# ==========================================
FROM oven/bun:1.3.9-slim

WORKDIR /app

# Copy built application
COPY --from=builder /app/apps/web/build ./build
COPY --from=builder /app/apps/web/package.json ./package.json

# Copy node_modules (includes all workspace packages)
COPY --from=builder /app/node_modules ./node_modules

# Merge the app-local node_modules too — version-conflicted packages
# don't hoist to root and would otherwise be missing at runtime.
COPY --from=builder /app/apps/web/node_modules ./node_modules

# Fail the BUILD if runtime deps didn't survive as resolvable modules
# (dangling symlinks fail `test -e` on the file behind them).
RUN test -e node_modules/drizzle-orm/package.json \
	&& test -e node_modules/postgres/package.json \
	|| (echo "FATAL: runtime node_modules missing/dangling — check --linker=hoisted in builder" && exit 1)

# Copy workspace packages (for runtime imports)
COPY --from=builder /app/packages ./packages

# Set environment variables
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD bun run -e "fetch('http://localhost:3000').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

# Start the application
CMD ["bun", "run", "build/index.js"]
