# ─────────────────────────────────────────────────────────────────────────────
# SEPHAR STUDIOS — Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
ORIGIN=https://sepharstudios.com

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/sepharstudios

# ── Better Auth ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your-secret-here-min-32-chars
BETTER_AUTH_URL=https://sepharstudios.com
BETTER_API_URL=https://sepharstudios.com/api/auth

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REDIRECT_URI=https://sepharstudios.com/api/auth/callback/google

# ── MinIO (Object Storage) ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=sephar-uploads

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_WEBHOOK=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sepharstudios.com

# ── Paystack (Fiat Payments) ──────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...

# ── Internal Auth ─────────────────────────────────────────────────────────────
SEPHAR_BACKEND_TOKEN=your-internal-shared-secret

# ─────────────────────────────────────────────────────────────────────────────
# AI — HYBRID SYSTEM (Ollama local + OpenRouter cloud)
# ─────────────────────────────────────────────────────────────────────────────
#
# The platform uses two AI providers strategically:
#
#  ┌─────────────────────────────────────────────────────────────────────────┐
#  │  OLLAMA (local, on your VPS)  ←  HIGH FREQUENCY, ZERO COST            │
#  │                                                                         │
#  │  Used for tasks that run thousands of times per day:                   │
#  │    • Content auto-tagging    (every video upload)                      │
#  │    • Recommendations         (every homepage load)                     │
#  │    • Semantic search         (every search)                            │
#  │    • Comment moderation      (every comment submitted)                 │
#  │    • Token/reward scoring    (every watch session completed)           │
#  │    • Bot/farming detection   (periodic background scan)                │
#  │    • Basic scene insight     (short "lesson here" answer)              │
#  │    • Portfolio narration     (simple NFT collection summary)           │
#  │    • Blockchain narration    (activity feed text)                      │
#  │                                                                         │
#  │  Cost: $0 — runs on your VPS RAM                                       │
#  └─────────────────────────────────────────────────────────────────────────┘
#
#  ┌─────────────────────────────────────────────────────────────────────────┐
#  │  OPENROUTER (cloud)  ←  HIGH VALUE, LOW FREQUENCY                     │
#  │                                                                         │
#  │  Used only for tasks that demand deep reasoning, called sparingly:     │
#  │    • Watch Companion chat    (user asks complex questions)             │
#  │    • Creator insight report  (creator opens dashboard)                 │
#  │    • Title optimizer         (creator explicitly clicks "optimize")    │
#  │    • NFT lore generation     (only runs at mint time)                  │
#  │                                                                         │
#  │  Cost: ~$0.0002–$0.001 per call (only when needed)                    │
#  └─────────────────────────────────────────────────────────────────────────┘
#
#  If Ollama is down → Ollama tasks automatically fallback to OpenRouter.
#  If a feature has no provider available → it fails silently (no crash).
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama (Local — Docker service, runs on your VPS) ─────────────────────────
#
# TWO MODELS, TWO JOBS:
#
#   CHAT MODEL  (Gemma 4) — conversational, faith-aware
#     → Watch companion chat, scene insights, portfolio narration, activity feed
#     → Warm, natural language, theological nuance
#
#   AGENT MODEL (Hermes 3) — structured JSON, function-calling grade
#     → Content tagging, moderation, token scoring, NFT metadata, recommendations
#     → Reliable JSON output, classification, multi-step reasoning
#
# Pull both models once after deploying:
#   docker exec -it sephar-ollama ollama pull gemma4:12b
#   docker exec -it sephar-ollama ollama pull hermes3:8b
#
# RAM guide (you need both loaded):
#   hermes3:8b  + gemma4:12b  → ~18GB  (recommended, 24GB VPS)
#   hermes3:8b  + gemma4:2b   → ~11GB  (budget VPS, 16GB)
#   hermes3:8b  + gemma4:27b  → ~33GB  (high-end / GPU server)
#
OLLAMA_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=gemma4:12b
OLLAMA_AGENT_MODEL=hermes3:8b

# ── OpenRouter (Cloud — fallback when Ollama is down, or for high-value tasks) ─
# 1. Go to: https://openrouter.ai/keys
# 2. Sign up free → Create API key
# 3. Paste below
#
# Chat fallback (Gemma 4 equivalent on cloud):
#   google/gemma-2-27b-it          → best Gemma-family conversational model
#   anthropic/claude-3-haiku       → excellent quality, still affordable
#
# Agent fallback (Hermes 3 equivalent on cloud):
#   nousresearch/hermes-3-llama-3.1-405b:extended → best structured JSON model
#
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_CHAT_MODEL=google/gemma-2-27b-it
OPENROUTER_AGENT_MODEL=nousresearch/hermes-3-llama-3.1-405b:extended
